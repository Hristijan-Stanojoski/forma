{
  "name": "Forma",
  "short_name": "Forma",
  "description": "Personal fitness, nutrition, home, work and finance dashboard.",
  "start_url": "./#dashboard",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f8f7",
